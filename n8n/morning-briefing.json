    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GROQ_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"openai/gpt-oss-20b\", messages: [{ role: \"user\", content: `Sammanfatta varje mejl i en mening på svenska. Om listan är tom, svara EXAKT med {\"emails\": []}. Svara ENDAST med JSON: {\"emails\": [{\\\"from\\\": string, \\\"subject\\\": string, \\\"summary\\\": string}]}. Mejl: ${JSON.stringify($('Gmail: Search Important').all().map(i => i.json).filter(m => m.id))}` }], response_format: { type: \"json_object\" } }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4a11-8b11-000000000004",
      "name": "Gemini: Summarize Emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -320,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const emails = JSON.parse($input.first().json.choices[0].message.content).emails || [];\nconst events = $('Calendar: Get Today').all().filter(i => i.json.id).map(i => ({\n  time: (i.json.start?.dateTime || i.json.start?.date || '').slice(11, 16) || 'Heldag',\n  title: i.json.summary || '(utan titel)',\n  location: i.json.location\n}));\nreturn [{ json: { events, important_emails: emails } }];"
      },
      "id": "a1b2c3d4-0005-4a11-8b11-000000000005",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst eventsText = data.events.length\n  ? data.events.map(e => `- ${e.time} — ${e.title}${e.location ? ' (' + e.location + ')' : ''}`).join('\\n')\n  : 'Inga händelser idag.';\nconst emailsText = data.important_emails.length\n  ? data.important_emails.map(m => `- ${m.from}: ${m.subject} — ${m.summary}`).join('\\n')\n  : 'Inga viktiga mejl just nu.';\nconst body = `God morgon!\\n\\nKalender idag:\\n${eventsText}\\n\\nViktiga mejl:\\n${emailsText}`;\nreturn [{ json: { body } }];"
      },
      "id": "a1b2c3d4-0006-4a11-8b11-000000000006",
      "name": "Format Briefing Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        400
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "samuel.ss74@gmail.com",
        "subject": "Din morgonbriefing",
        "message": "={{$json.body}}",
        "options": {}
      },
