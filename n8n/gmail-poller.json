    {
      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  const parsed = JSON.parse(item.json.choices[0].message.content);\n  const mail = $('Gmail: Search Team Mail').itemMatching(i).json;\n  return { json: { ...parsed, gmail_message_id: mail.id } };\n});"
      },
