    {
      "parameters": {
        "jsCode": "const gmailItems = $('Gmail: Search Team Mail').all();\nconst checked = $input.all();\nreturn gmailItems.map((item, i) => {\n  const seen = checked[i] && checked[i].json && Object.keys(checked[i].json).length > 0;\n  return { json: { ...item.json, _alreadySeen: !!seen } };\n});"
      },
